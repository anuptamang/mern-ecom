# Client Environment Variables
# Copy this file to .env and update with your actual values
# Note: Only variables prefixed with REACT_APP_ are exposed to the client bundle

# Backend API URL
# This should point to your backend server URL
REACT_APP_BACKEND_API_URL=http://localhost:3010

# Alternative: If using REACT_APP_API_URL (legacy support)
REACT_APP_API_URL=http://localhost:3010

# Stripe Publishable Key (for checkout)
# Get this from your Stripe Dashboard: https://dashboard.stripe.com/apikeys
REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Note: In production, update REACT_APP_BACKEND_API_URL to your production backend URL
# Example: REACT_APP_BACKEND_API_URL=https://api.yoursite.com
