{
  "name": "enterprise-ecommerce-platform",
  "version": "1.0.0",
  "description": "Enterprise-grade MERN stack e-commerce platform template",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "start": "cd server && npm start",
    "test": "concurrently \"npm run test:server\" \"npm run test:client\"",
    "test:server": "cd server && npm test",
    "test:client": "cd client && npm test",
    "lint": "cd client && npm run lint",
    "lint:fix": "cd client && npm run lint:fix",
    "format": "prettier --write './**/*.{js,jsx,ts,tsx,css,scss,json,md}'",
    "docker:build": "docker build -t ecommerce-app .",
    "docker:run": "docker run -p 3010:3010 --env-file server/.env ecommerce-app",
    "docker:compose": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "prepare": "husky install"
  },
  "keywords": [
    "ecommerce",
    "mern",
    "react",
    "nodejs",
    "mongodb",
    "template",
    "enterprise"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "express-rate-limit": "^8.2.1",
    "husky": "^8.0.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": ""
  },
  "bugs": {
    "url": ""
  },
  "homepage": ""
}
